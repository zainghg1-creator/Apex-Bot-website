{
  "version": 2,
  "cleanUrls": true,
  "builds": [
    {
      "src": "server-secure.js",
      "use": "@vercel/node"
    },
    {
      "src": "*.html",
      "use": "@vercel/static"
    },
    {
      "src": "*.css",
      "use": "@vercel/static"
    },
    {
      "src": "*.js",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "/server-secure.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server-secure.js"
    },
    {
      "src": "/(.*)",
      "dest": "/$1"
    }
  ]
}
