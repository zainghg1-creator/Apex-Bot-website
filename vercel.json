{
  "version": 2,
  "builds": [
    {
      "src": "server.js",
      "use": "@vercel/node"
    }
  ],
  "routes": [
    {
      "src": "/auth/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/api/(.*)",
      "dest": "/server.js"
    },
    {
      "src": "/dashboard.js",
      "dest": "/public/dashboard.js"
    },
    {
      "src": "/dashboardstyle.css",
      "dest": "/public/dashboardstyle.css"
    },
    {
      "src": "/tabs/(.*)",
      "dest": "/public/tabs/$1"
    },
    {
      "src": "/public/(.*)",
      "dest": "/public/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/server.js"
    }
  ]
}
